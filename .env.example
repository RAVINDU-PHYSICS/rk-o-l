# Copy to .env.local and fill in. NEVER commit real values.

# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used ONLY by `npm run create-admin` (one-time admin provisioning). Remove afterwards.
ADMIN_EMAIL=ravindukarunarathne07@gmail.com
ADMIN_INITIAL_PASSWORD=choose-a-long-random-password-here

# Optional: Cloudflare Turnstile bot protection for register/contact forms.
# If unset, only honeypot + database rate limiting are used.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
